{
  "name": "hospital-form-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 && npm run lint:css-vars && npm run lint:memberships-door && npm run lint:client-server-imports && npm run lint:vacuous && npm run lint:set-local && npm run lint:progress && npm run lint:rules && npm run lint:adr-index",
    "lint:css-vars": "node scripts/check-tailwind-css-vars.mjs",
    "lint:memberships-door": "node scripts/check-memberships-door.mjs",
    "lint:client-server-imports": "node scripts/check-client-server-imports.mjs --gate",
    "lint:vacuous": "node scripts/check-vacuous-assertions.mjs --gate",
    "lint:set-local": "node scripts/check-migration-set-local.mjs",
    "lint:progress": "node scripts/check-progress-doc.mjs",
    "lint:rules": "node scripts/check-rules-staleness.mjs",
    "lint:adr-index": "node scripts/build-adr-index.mjs --check",
    "adr:index": "node scripts/build-adr-index.mjs --write",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:types": "supabase gen types typescript --local > src/lib/types/database.ts",
    "gen:types:linked": "supabase gen types typescript --linked > src/lib/types/database.ts",
    "db:link": "supabase link --project-ref azkbbhskturikxpgmafq",
    "db:push": "supabase db push",
    "db:reset:linked": "supabase db reset --linked",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:prod": "bash scripts/e2e-prod-gate.sh",
    "sweep:embeds": "node scripts/extract-embeds.mjs . .embed-sweep && node scripts/probe-embeds.mjs . .embed-sweep",
    "storage:manifest": "node scripts/storage-manifest.mjs",
    "storage:walk": "node scripts/storage-manifest.mjs walk",
    "storage:selftest": "node scripts/storage-manifest.mjs selftest",
    "storage:rehearse": "node scripts/storage-manifest.mjs rehearse"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "gsap": "3.15.0",
    "lucide-react": "^1.17.0",
    "next": "16.3.2",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.5.0",
    "react": "19.2.8",
    "react-aria-components": "^1.19.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "shadcn": "^4.19.0",
    "supabase": "^2.105.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
