# Copy to `.env.local` (gitignored) and fill the keys from your Supabase
# project's dashboard under Project Settings → API.

# Client-exposed — safe to ship to the browser. ONLY the URL and anon key may
# carry the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — used in server route handlers that legitimately bypass RLS
# (e.g. user invitations). NEVER expose to the client and NEVER add a
# NEXT_PUBLIC_ prefix. A service-role key in client code is a phase-blocking bug.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY — Resend API key used as the SMTP password for Supabase Auth
# emails (local: supabase/config.toml [auth.email.smtp]; prod: Dashboard →
# Authentication → SMTP Settings, entered directly there, not read from env).
RESEND_API_KEY=

# SERVER ONLY — gates the invite/email onboarding flow. DEFAULT OFF: when unset
# (or anything other than `on`/`true`), registering a user creates the account
# ACTIVE with an admin-set initial password and NO email verification — the
# path to use until a production domain + working SMTP exist. Set to `on` (or
# `true`) ONLY after SMTP is delivering, to restore the invite/email flow where
# the user sets their own password via the emailed activation link. Server-only:
# do NOT add a NEXT_PUBLIC_ prefix (it must not reach the client bundle).
AUTH_EMAIL_VERIFICATION=off

# --- MIN · meeting audio → generated ata (ADR 0099). ALL SERVER ONLY. ---------
# The feature is additionally gated by the `audio_minutes` feature flag, which ships
# OFF: with the flag off these may be unset and nothing breaks. With the flag ON and
# these unset, `submitMinutesJob` fails cleanly in pt-BR rather than hanging a job.

# Base URL of the `minute_generator` service (no trailing slash).
MINUTES_SERVICE_URL=http://localhost:8000
# Bearer token the service checks on POST /jobs, POST /jobs/{id}/cancel, GET /jobs/{id}.
# Must equal the service's own API_KEY.
MINUTES_SERVICE_API_KEY=
# Shared secret for the callback signature. Must equal the service's
# CALLBACK_HMAC_SECRET exactly — a mismatch makes every callback a silent 401 and
# every job time out at 24 h with no error pointing at auth.
MINUTES_CALLBACK_HMAC_SECRET=

# OPTIONAL override for the callback URL's origin (no trailing slash; the
# `/api/webhooks/audio-jobs` path is appended). Leave UNSET in normal deployments —
# the origin is then taken from the incoming request, which is correct wherever the
# service reaches us on the same public URL a browser does.
# Set it when the SERVICE's view of us differs from the BROWSER's:
#   - running the service locally in Docker against `npm run dev`:
#       MINUTES_CALLBACK_BASE_URL=http://host.docker.internal:3000
#   - the app sits behind a proxy that rewrites Host, or the service reaches us on an
#     internal address.
# MINUTES_CALLBACK_BASE_URL=

# --- PDF printing · Gotenberg sidecar (ADR 0104). ALL SERVER ONLY. ------------
# The module is additionally gated by the `document_printing` feature flag, which
# ships OFF: with the flag off these may be unset and nothing breaks. With the flag
# ON and PDF_RENDERER_URL unset, minting fails cleanly in pt-BR — nothing is minted
# (D5: all-or-nothing). Do NOT add a NEXT_PUBLIC_ prefix to either.

# Base URL of the pinned Gotenberg container (no trailing slash). The sidecar has
# NO public domain — private Docker network in prod (ADR 0104 D14); locally the
# docker-run recipe in docs/deployment/pdf-renderer.md publishes it on :3010.
PDF_RENDERER_URL=http://localhost:3010

# PUBLIC origin the printed QR encodes (`<base>/verificar/<token>`, no trailing
# slash). CONFIGURED, never derived from request headers — a spoofable Host must
# never end up printed on paper. Local dev: http://localhost:3000; prod: the
# platform's public URL.
PDF_VERIFICATION_BASE_URL=http://localhost:3000
