{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "enabledPlugins": {
    "postgres-best-practices@supabase-agent-skills": true,
    "supabase@supabase-agent-skills": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "graphify",
            "args": ["hook-guard", "search"]
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify",
            "args": ["hook-guard", "read"]
          }
        ]
      }
    ]
  }
}