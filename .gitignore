# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# playwright
/test-results/
/playwright-report/
/playwright/.cache/
# ad-hoc run logs captured during gate runs (redirected output, never source)
/playwright-*.txt
/prod-server*.log
# e2e-generated temp upload fixtures (written at runtime by specs, never source)
e2e/__tmp_*

# vercel
.vercel

# git worktrees (Claude Code EnterWorktree-managed + manual) — each has its own
# .git file with a host-specific absolute path; never commit one. See docs/worktrees.md.
/.claude/worktrees/
/worktrees/

# typescript
*.tsbuildinfo
next-env.d.ts

# personal Pictures library accidentally nested under docs/design (not project design assets)
docs/design/Pictures/

# graphify: keep the queryable graph + report committed, ignore regenerable local state
# (cache/ churns on every `graphify update`; dated dirs are rebuild backups)
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# `npm run sweep:embeds` scratch (regenerated from src/ + the live schema cache)
.embed-sweep/

# authz sweep scratch (p0-authz-*-audit.sh WORK dir) — neutralized-function backups and
# per-case run logs; regenerated every run, and some filenames exceed git.
.authz-work/

# CLAUDE.md review-cadence queue (Stop hook output) — per-checkout working state, never record
/.claude/claude-md-review-queue.md
