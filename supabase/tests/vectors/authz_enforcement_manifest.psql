create temp table authz_manifest_snapshot_roles on commit drop as
  select * from (values
    ('administrativo', 'legacy', false),
    ('hospital_admin', 'legacy', true),
    ('nsp_coordinator', 'legacy', true),
    ('nsp_org_admin', 'legacy', true),
    ('org_admin', 'legacy', true),
    ('platform_admin', 'legacy', true),
    ('pqs_member', 'legacy', true),
    ('quality_reviewer', 'legacy', true),
    ('staff', 'legacy', true),
    ('staff_admin', 'authoritative', true),
    ('technical_director', 'legacy', true),
    ('technical_director_deputy', 'legacy', true)
  ) as t(code, state, session_selectable);

create temp table authz_manifest_approved_suites on commit drop as
  select * from (values
    ('staff_admin')
  ) as t(role_code);

create temp table authz_manifest_hard_deny_vocab on commit drop as
  select * from (values
    ('principal_inactive', 'app.is_active'),
    ('record_immutable_published', null::text),
    ('record_immutable_submitted', null::text),
    ('recusal_exclusion', 'app.is_case_excluded'),
    ('respondent_exclusion', 'app.is_case_respondent'),
    ('sensitivity_ceiling', null::text),
    ('tenant_mismatch', null::text)
  ) as t(class_name, gate);
