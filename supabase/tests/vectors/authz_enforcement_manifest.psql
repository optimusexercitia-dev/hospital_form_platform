create temp table authz_manifest_hard_deny_vocab on commit drop as
  select * from (values
    ('principal_inactive', 'app.is_active'),
    ('record_immutable_published', null::text),
    ('record_immutable_submitted', null::text),
    ('recusal_exclusion', 'app.is_case_excluded'),
    ('respondent_exclusion', 'app.is_case_respondent'),
    ('sensitivity_ceiling', null::text),
    ('tenant_mismatch', null::text)
  ) as t(class_name, gate);

-- ADR 0193 D5 — every SECURITY DEFINER writer behind a declared site's relation, declared with
-- the gate it actually carries. `gate` is NULLABLE and null means MEASURED: a door with no
-- authority check at all.
create temp table authz_manifest_definer_surface on commit drop as
  select * from (values
    ('commission.forms.edit', 'app', '_insert_block_child_rows', array['form_item_options', 'form_item_validations', 'form_matrix_columns', 'form_matrix_rows'], null::text, null::text, null::text, false, true),
