    ('commission.forms.edit', 'public', 'delete_block_library_entry', array['form_block_library'], 'app.is_staff_admin_of', null::text, null::text, false, true),
    ('commission.forms.edit', 'public', 'insert_block_from_library', array['form_items'], 'app.is_staff_admin_of', null::text, null::text, false, true),
    ('commission.forms.edit', 'public', 'save_block_to_library', array['form_block_library'], 'app.is_staff_admin_of', null::text, null::text, false, true),
    ('commission.forms.edit', 'public', 'set_item_validations', array['form_item_validations'], 'app.can_edit_commission_forms', null::text, null::text, false, true),
    ('commission.forms.edit', 'public', 'update_block_library_entry', array['form_block_library'], 'app.is_staff_admin_of', null::text, null::text, false, true),
    ('commission.forms.edit', 'public', 'upsert_matrix_axes', array['form_matrix_columns', 'form_matrix_rows'], 'app.is_staff_admin_of', null::text, null::text, false, true),
    ('commission.meetings.minutes.sign', 'public', 'reopen_meeting', array['meeting_signatures', 'meetings'], 'app.is_staff_admin_of', null::text, null::text, false, true),
    ('commission.meetings.minutes.sign', 'public', 'sign_meeting', array['meeting_signatures', 'meetings'], 'app.can_sign_meeting', null::text, null::text, false, true),
    ('commission.responses.create', 'public', 'reject_correction', array['case_correction_requests', 'responses'], 'app.is_staff_admin_of', null::text, null::text, false, true),
    ('commission.responses.create', 'public', 'start_correction_draft', array['case_correction_requests', 'responses'], null::text, 'identity', 'auth.uid() is distinct from v_corrector', false, true),
    ('commission.responses.create', 'public', 'submit_targeted_case_response', array['responses'], 'app.can_access_targeted_response', null::text, null::text, false, true),
    ('commission.responses.create', 'public', 'supersede_response', array['responses'], 'app.is_staff_admin_of', null::text, null::text, false, true),
    ('commission.responses.create', 'public', 'target_case_response', array['responses'], 'app.is_staff_admin_of', null::text, null::text, false, true),
    ('commission.responses.create', 'public', 'withdraw_correction', array['case_correction_requests', 'responses'], 'app.is_staff_admin_of', null::text, null::text, false, true)
  ) as t(code, fn_schema, fn_name, writes, gate, gate_kind, gate_expression, carries_code, exec_authenticated);

-- ADR 0193 D7 — consumers of a domain authorizer that are deliberately NOT enforcement sites.
-- ⛔ Adding one of these to `enforcementSites` would make § 8's site-axis closure measure a
-- fiction; leaving it undeclared leaves the consumer axis open. It is a third state, declared.
create temp table authz_manifest_non_enforcement_consumers on commit drop as
  select * from (values
    ('org.professionals.read', 'app', '_audit_access_authorized', 'function', 'Architecture Rule 11 AUDIT REGISTRY, not a door. `app._audit_access_authorized(p_action, p_entity_id, p_commission)` is an 18-arm `case p_action` registry whose `professional_profile.read` arm returns `app.can_read_professional_profile(p_entity_id, v_uid)`. It CONSUMES the authorizer to decide whether a read that already happened was authorized, so denying it changes what the audit trail RECORDS, never what a caller may read. ⛔ Declaring it an enforcementSite would make the site-axis closure (410 § 8) measure a fiction: § 8.4 would look for a policy or door reaching the code and find a logging predicate instead.')
  ) as t(code, fn_schema, fn_name, consumer_kind, reason);
