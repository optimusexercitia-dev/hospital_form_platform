# =============================================================================
# Production / Coolify environment reference
# -----------------------------------------------------------------------------
# These are the variables to enter in the Coolify application's "Environment
# Variables" tab (NOT committed — this file is only a template/checklist).
# See docs/deployment/coolify.md for the full runbook.
#
# Two scopes matter in Coolify:
#   • BUILD  — the NEXT_PUBLIC_* vars are baked into the client JS at `next build`.
#              In Coolify, toggle "Build Variable? = Yes" on these so they are
#              passed as --build-arg (the Dockerfile declares matching ARGs).
#   • RUNTIME — everything is also available to the running container. Server-only
#              secrets (no NEXT_PUBLIC_ prefix) must NEVER be Build Variables and
#              must never reach the browser bundle.
# =============================================================================

# ── Client-exposed (BUILD + runtime) — safe in the browser ───────────────────
# Existing Cloud project: azkbbhskturikxpgmafq. Confirm the anon key against
# Supabase Dashboard → Project Settings → API (it may have rotated).
NEXT_PUBLIC_SUPABASE_URL=https://azkbbhskturikxpgmafq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── SERVER ONLY (runtime) — never a Build Variable, never NEXT_PUBLIC_ ────────
# Dashboard → Project Settings → API → service_role secret. Bypasses RLS; used
# only in server route handlers (e.g. user invitations).
SUPABASE_SERVICE_ROLE_KEY=

# Gates the invite/email onboarding flow. Keep `off` until a production domain +
# working SMTP (Resend, configured in the Supabase Dashboard) are live; then flip
# to `on` to require email verification and let users set their own password.
AUTH_EMAIL_VERIFICATION=off

# Only needed if AUTH_EMAIL_VERIFICATION=on AND you drive SMTP from the app.
# NOTE: on Supabase Cloud, auth emails are sent via the Dashboard SMTP settings,
# not this env var — leave blank unless a server route sends mail directly.
RESEND_API_KEY=

# ── MIN · meeting audio → generated ata (ADR 0099). SERVER ONLY (runtime) ─────
# Additionally gated by the `audio_minutes` feature flag, which ships OFF: with the
# flag off these may be absent and nothing breaks. With the flag ON and the first
# three absent, `submitMinutesJob` fails cleanly in pt-BR and the job terminates —
# it does not hang. The `minute_generator` service is its own Coolify resource;
# deploy order, the pre-enable gates and key rotation live in
# docs/deployment/audio-minutes-runbook.md.
#
# ⚠ Mint NEW production secrets — never reuse the local smoke pair. The first two
# must equal the service's own API_KEY / CALLBACK_HMAC_SECRET exactly; a mismatch
# on the second makes every callback a silent 401 and every job time out at 24 h
# with nothing in the symptom pointing at auth.

# Base URL of the deployed minute_generator service (no trailing slash).
MINUTES_SERVICE_URL=
# Bearer token sent to the service on submit/cancel/status. = its API_KEY.
MINUTES_SERVICE_API_KEY=
# Verifies the inbound callback signature. = its CALLBACK_HMAC_SECRET.
MINUTES_CALLBACK_HMAC_SECRET=

# OPTIONAL origin override for the callback URL (the `/api/webhooks/audio-jobs`
# path is appended). LEAVE UNSET in normal production — the origin is then taken
# from the incoming request, which is correct wherever the service reaches the app
# on the same public URL a browser does. Set it only when the SERVICE's view of the
# app differs from a BROWSER's: behind a Host-rewriting proxy, or when the service
# reaches the app on an internal address.
# MINUTES_CALLBACK_BASE_URL=

# ── PDF·P1 · document printing · Gotenberg sidecar (ADR 0104). SERVER ONLY ────
# Additionally gated by the `document_printing` feature flag, which ships OFF: with
# the flag off these may be absent and nothing breaks. With the flag ON and
# PDF_RENDERER_URL unset, minting fails cleanly in pt-BR and nothing is minted
# (D5: all-or-nothing) — downloads and /verificar keep working either way, they
# never touch the renderer. Sidecar setup (its own Coolify resource, pinned image,
# resource caps, no public domain): docs/deployment/pdf-renderer.md.

# Internal address of the Gotenberg sidecar (no trailing slash). NOT a public
# domain: the sidecar gets no FQDN and no HTTPS route (ADR 0104 D14) — from P3
# onward the HTML it receives IS the PHI, so privacy of the network path is the
# load-bearing property. Put it on the app's Coolify network and address it by
# service name. The port is the CONTAINER's 3000, always — the `:3010` in
# .env.example is a local host mapping only, because 3000 is `next dev`.
PDF_RENDERER_URL=http://<coolify-service-name>:3000

# PUBLIC origin encoded in every printed QR (`<base>/verificar/<token>`), no
# trailing slash — the platform's own public URL, e.g. https://app.yourdomain.com.
# ⚠ CONFIGURED, never derived from request headers: a spoofable Host must never end
# up printed on paper. This is the OPPOSITE of MINUTES_CALLBACK_BASE_URL above,
# which is deliberately left unset — do not pattern one on the other.
PDF_VERIFICATION_BASE_URL=

# The Dockerfile already sets NODE_ENV=production, PORT=3000, HOSTNAME=0.0.0.0.
# Override here only if you must.
