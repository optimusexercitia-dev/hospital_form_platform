# =============================================================================
# Production / Coolify environment reference
# -----------------------------------------------------------------------------
# These are the variables to enter in the Coolify application's "Environment
# Variables" tab (NOT committed — this file is only a template/checklist).
# See docs/deployment/coolify.md for the full runbook.
#
# Two scopes matter in Coolify:
#   • BUILD  — the NEXT_PUBLIC_* vars are baked into the client JS at `next build`.
#              In Coolify, toggle "Build Variable? = Yes" on these so they are
#              passed as --build-arg (the Dockerfile declares matching ARGs).
#   • RUNTIME — everything is also available to the running container. Server-only
#              secrets (no NEXT_PUBLIC_ prefix) must NEVER be Build Variables and
#              must never reach the browser bundle.
# =============================================================================

# ── Client-exposed (BUILD + runtime) — safe in the browser ───────────────────
# Existing Cloud project: azkbbhskturikxpgmafq. Confirm the anon key against
# Supabase Dashboard → Project Settings → API (it may have rotated).
NEXT_PUBLIC_SUPABASE_URL=https://azkbbhskturikxpgmafq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── SERVER ONLY (runtime) — never a Build Variable, never NEXT_PUBLIC_ ────────
# Dashboard → Project Settings → API → service_role secret. Bypasses RLS; used
# only in server route handlers (e.g. user invitations).
SUPABASE_SERVICE_ROLE_KEY=

# Gates the invite/email onboarding flow. Keep `off` until a production domain +
# working SMTP (Resend, configured in the Supabase Dashboard) are live; then flip
# to `on` to require email verification and let users set their own password.
AUTH_EMAIL_VERIFICATION=off

# Only needed if AUTH_EMAIL_VERIFICATION=on AND you drive SMTP from the app.
# NOTE: on Supabase Cloud, auth emails are sent via the Dashboard SMTP settings,
# not this env var — leave blank unless a server route sends mail directly.
RESEND_API_KEY=

# The Dockerfile already sets NODE_ENV=production, PORT=3000, HOSTNAME=0.0.0.0.
# Override here only if you must.
